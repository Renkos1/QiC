# Public entrypoint. SITE_ADDRESS is a domain (automatic HTTPS via ACME) or "localhost"
# for a local rehearsal (Caddy's internal CA; browsers will warn).
{$SITE_ADDRESS} {
	encode zstd gzip

	# The API is served on the same origin, so auth cookies stay first-party.
	handle /api/* {
		reverse_proxy api:4000
	}

	# Health endpoints stay internal (container health checks), never public.
	@internal path /healthz /readyz
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
