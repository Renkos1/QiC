# Copy to .env.prod on the server (never commit it) and fill every value.
# Generate secrets with: openssl rand -base64 32
# 在服务器上复制为 .env.prod（不要提交）并填写所有值；密钥用 `openssl rand -base64 32` 生成。

# --- Public entrypoint (Caddy) / 对外入口 ---
# Domain with DNS pointing at this server; Caddy obtains the certificate automatically.
# 已解析到本机的域名；Caddy 自动申请证书。
SITE_ADDRESS=qic.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Shared runtime / 运行时 ---
NODE_ENV=production
LOG_LEVEL=info
# Must equal https://<SITE_ADDRESS>; auth links and cookies are issued for it.
# 必须等于 https://<SITE_ADDRESS>；鉴权链接和 Cookie 都针对它签发。
PUBLIC_WEB_URL=https://qic.example.com

# --- Data stores (internal network only) / 数据存储（仅内网） ---
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- Auth / 鉴权 ---
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# On by default in production; only turn off for load tests or local rehearsals.
# 生产环境默认开启限流；只在压测或本地演练时关闭。
# RATE_LIMIT_ENABLED=false

# --- Mail (worker) / 邮件 ---
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=QiC <no-reply@qic.example.com>

# --- AI (optional; features are disabled when unset) / AI（可选，未设置时关闭） ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# Enables the LLM cost metric (USD per million tokens). 设置后记录 LLM 成本指标（每百万 token 美元价格）。
# AI_PRICE_INPUT_USD_PER_MTOK=
# AI_PRICE_OUTPUT_USD_PER_MTOK=

# --- Observability (optional; off when unset) / 可观测性（可选，未设置时关闭） ---
# Any OTLP/HTTP endpoint (Grafana Cloud, an OpenTelemetry Collector, ...); add auth via OTEL_EXPORTER_OTLP_HEADERS.
# 任意 OTLP/HTTP 端点（Grafana Cloud、OpenTelemetry Collector 等）；鉴权通过 OTEL_EXPORTER_OTLP_HEADERS 配置。
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
