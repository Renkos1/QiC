# Dependencies. 依赖。
node_modules/
.pnpm-store/

# Build output. 构建产物。
dist/
build/
out/
.next/
*.tsbuildinfo

# Tooling caches. 工具缓存。
.turbo/
.cache/
coverage/
.eslintcache

# Test artifacts. 测试产物。
playwright-report/
test-results/
blob-report/

# Env files: only the *.example templates are committed. 环境变量文件：只提交 *.example 模板。
.env
.env.*
!.env.example
!.env.*.example

# Logs. 日志。
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor; shared VS Code launch and extension recommendations stay. 系统与编辑器文件；共享的 VS Code 调试配置与插件推荐保留。
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json

# Personal Claude Code overrides (shared settings go in .claude/settings.json). 个人的 Claude Code 覆盖配置。
.claude/settings.local.json

# Regenerated by `next dev` / `next build`. 由 Next 自动生成。
next-env.d.ts

# Playwright artifacts. Playwright 报告与失败记录。
tests/e2e/playwright-report/
tests/e2e/test-results/

# Eval run output (the baseline itself is committed). 评测运行结果（基线文件本身要提交）。
evals/results/

# Server-side deploy state written by infra/compose/deploy.sh. 部署脚本在服务器上写入的状态文件。
infra/compose/.env.images*
