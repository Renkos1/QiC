{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@qic/config/tsconfig/node.json",
  "compilerOptions": {
    // Nest's parameter decorators need the legacy decorator transform. No
    // emitDecoratorMetadata: providers are injected by token (see src/tokens.ts).
    "experimentalDecorators": true
  },
  "include": ["src", "vitest.config.ts", "vitest.int.config.ts"]
}
