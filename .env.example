# Copy to .env only when you need to override a default. Every variable below is
# optional in development (defaults match docker-compose.yml) and validated at startup.
# Variables marked [prod] are required when NODE_ENV=production. Never commit .env.
# 只有需要覆盖默认值时才复制为 .env。开发环境下所有变量都可省略（默认值与 docker-compose.yml 一致），
# 启动时会校验。标记 [prod] 的变量在生产环境必须设置。不要提交 .env。

# --- Runtime / 运行时 ---
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database / 数据库 (packages/db, apps/api) --- [prod]
DATABASE_URL=postgres://qic:qic@localhost:15432/qic

# --- Redis / queues 队列 (apps/api, apps/worker) --- [prod]
REDIS_URL=redis://localhost:16379

# --- api (apps/api) ---
PORT=14000
# Public origin users see (the web app); auth links and cookies are issued for it. [prod]
# 用户访问的公开地址；鉴权链接和 Cookie 都针对它签发。
PUBLIC_WEB_URL=http://localhost:13000
# At least 32 characters; generate with `openssl rand -base64 32`. [prod] 至少 32 个字符。
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789
# Rate limiting for sign-in/sign-up/reset emails and @RateLimit routes (e.g. AI).
# Default: on in production, off elsewhere. 限流开关：生产默认开启，其他环境默认关闭。
# RATE_LIMIT_ENABLED=true

# Build identifier reported by /healthz (set by the image build). 构建标识，由镜像构建写入。
GIT_SHA=dev

# --- AI (apps/api, packages/ai) ---
# Optional. When unset, AI features are disabled and the UI says so. 可选；未设置时关闭 AI 功能，界面会提示。
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override; defaults to claude-opus-5.
# AI_MODEL=claude-opus-5
# Optional USD price per million input/output tokens; enables the LLM cost metric.
# 可选：每百万输入/输出 token 的美元价格，设置后记录 LLM 成本指标。
# AI_PRICE_INPUT_USD_PER_MTOK=
# AI_PRICE_OUTPUT_USD_PER_MTOK=
# Record prompts and outputs on traces (may contain user data; never in production).
# 在 trace 中记录提示词和输出（可能含用户数据，生产环境不要开启）。
# AI_TRACE_CONTENT=false

# --- Observability / 可观测性 (apps/api, apps/worker, apps/web) ---
# All optional; each part stays off until its variable is set. See docs/developer-guide.md §6.
# 全部可选；未设置对应变量时该部分保持关闭。详见 docs/developer-guide.md §6。
# Traces, metrics and logs over OTLP/HTTP. Local: `docker compose --profile obs up -d`, Grafana on :13001.
# 通过 OTLP/HTTP 导出 trace、指标和日志。本地先启动 obs profile，Grafana 在 13001 端口。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
# Error reporting (server side). 服务端错误上报。
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# GenAI spans to Langfuse (Cloud or your own instance). 把 GenAI span 发送到 Langfuse。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Browser side, baked in at build time: error reporting and tracing via the /otlp relay.
# 浏览器端，构建时写入：错误上报，以及经 /otlp 中转的链路追踪。
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_OTEL_BROWSER=true

# --- web (apps/web) ---
# Internal origin of apps/api for server-side calls and the local /api proxy. [prod]
# api 的内部地址，供服务端调用和本地 /api 代理使用。
API_ORIGIN=http://localhost:14000

# --- Mail / 邮件 (apps/worker) --- [prod]
# Development uses Mailpit (http://localhost:18025). Production: smtps://user:pass@host:465
# Use 127.0.0.1, not localhost: nodemailer resolves hosts via DNS, not the hosts file.
# 开发环境使用 Mailpit；本地请写 127.0.0.1 而不是 localhost（nodemailer 不读 hosts 文件）。
SMTP_URL=smtp://127.0.0.1:11025
MAIL_FROM=QiC <no-reply@qic.local>
WORKER_CONCURRENCY=5
# Port of the worker health endpoint (GET /healthz) used by container health checks. worker 健康检查端口。
WORKER_HEALTH_PORT=14100
