# Normalize text to LF in the repository and working tree (Windows included). 仓库和工作区统一使用 LF。
* text=auto eol=lf

# Never touch line endings of binary assets. 二进制资源不做换行转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs and exclude from language stats. 生成文件：diff 中折叠，不计入语言统计。
pnpm-lock.yaml linguist-generated=true -diff
**/*.gen.ts linguist-generated=true
contracts/openapi/openapi.json linguist-generated=true
packages/db/migrations/meta/** linguist-generated=true
